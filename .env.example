# Copy this file to .env for local development (.env is gitignored).
#
# LAKEBASE_URL and MASSIVE_API_KEY here are LOCAL-DEV OVERRIDES: when set, the
# app uses them directly and never contacts Databricks. Leave them unset to
# read from the Databricks secret scopes instead (which is what the deployed
# app on Databricks Apps does - it has no .env).
#
# Do NOT commit a filled-in .env.

# <your-lakebase-host> is the full host from your Lakebase instance's connection
# details - it already includes its own domain (e.g. ep-xxx.<region>.aws.neon.tech).
# Paste it whole; do NOT append anything to it.
LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>:5432/databricks_postgres?sslmode=require
MASSIVE_API_KEY=<your-massive-api-key>

MASSIVE_API_BASE_URL=https://api.massive.com

# --- Databricks secret scope/key names (used when the vars above are unset) ---
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=lakebase-url
# MASSIVE_SECRET_SCOPE=massive
# MASSIVE_SECRET_KEY=api-key

# --- Optional local overrides ---
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=8000
# FLASK_DEBUG=1
# Email used to key the watchlist when running locally without Databricks auth.
# LOCAL_USER_EMAIL=local@dev
# Table names (defaults shown).
# MASSIVE_TABLE_NAME=massive_records
# WATCHLIST_TABLE_NAME=watchlist
# NEWS_TABLE_NAME=ticker_news_documents
# NEWS_TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA
